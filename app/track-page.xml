<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo" class="page">
    <Page.actionBar>
        <ActionBar title="{{ selectedPlaylist ? selectedPlaylist.name : 'Tracks' }}" class="action-bar">
            <NavigationButton text="Back" android.systemIcon="ic_menu_back" tap="onBackToPlaylists" />
            <ActionBar.actionItems>
                <ActionItem
                    ios.systemIcon="3"
                    android.systemIcon="ic_menu_add"
                    tap="onAddToPlaylist"
                    ios.position="right"
                    android.position="actionBar" />
            </ActionBar.actionItems>
        </ActionBar>
    </Page.actionBar>

    <GridLayout rows="*, auto" class="page-content">
        <ListView items="{{ tracks }}" itemTap="onTrackTap" class="list-group">
            <ListView.itemTemplate>
                <GridLayout columns="*, auto" class="list-group-item">
                    <Label text="{{ name }}" textWrap="true" class="h3" />
                    <Label col="1" text="{{ duration }}" class="h3 text-right" />
                </GridLayout>
            </ListView.itemTemplate>
        </ListView>

        <GridLayout row="1" columns="auto, *, auto" class="player-controls">
            <Button text="⏮" tap="onPreviousTrack" class="btn btn-primary" />
            <Button text="{{ isPlaying ? '⏸' : '▶' }}" tap="onPlayPause" class="btn btn-primary" />
            <Button text="⏭" tap="onNextTrack" class="btn btn-primary" />
        </GridLayout>

        <Progress value="{{ currentTimeValue }}" maxValue="{{ duration }}" class="progress" />
    </GridLayout>
</Page> 