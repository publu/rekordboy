<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo" class="page" frameId="main-frame">
    <Page.actionBar>
        <ActionBar title="RekordBoy" class="action-bar">
            <ActionBar.actionItems>
                <ActionItem
                    ios.systemIcon="9" 
                    android.systemIcon="ic_menu_add"
                    tap="onAddPlaylist"
                    ios.position="right"
                    android.position="actionBar" />
            </ActionBar.actionItems>
        </ActionBar>
    </Page.actionBar>

    <GridLayout rows="auto, *" class="page-content">
        <SegmentedBar row="0" selectedIndex="{{ viewMode === 'rekordbox' ? 0 : 1 }}" class="segmented-bar">
            <SegmentedBar.items>
                <SegmentedBarItem title="Rekordbox" />
                <SegmentedBarItem title="Local" />
            </SegmentedBar.items>
        </SegmentedBar>

        <StackLayout row="1">
            <!-- Rekordbox Playlists -->
            <ListView items="{{ playlists }}" visibility="{{ viewMode === 'rekordbox' ? 'visible' : 'collapsed' }}" 
                      itemTap="onPlaylistTap" class="list-group">
                <ListView.itemTemplate>
                    <GridLayout columns="*, auto" class="list-group-item">
                        <Label text="{{ name }}" textWrap="true" class="h3" />
                        <Label col="1" text="{{ trackCount }}" class="h3 text-right" />
                    </GridLayout>
                </ListView.itemTemplate>
            </ListView>

            <!-- Local Playlists -->
            <ListView items="{{ localPlaylists }}" visibility="{{ viewMode === 'local' ? 'visible' : 'collapsed' }}" 
                      itemTap="onPlaylistTap" class="list-group">
                <ListView.itemTemplate>
                    <GridLayout columns="*, auto" class="list-group-item">
                        <Label text="{{ name }}" textWrap="true" class="h3" />
                        <Label col="1" text="{{ tracks.length }}" class="h3 text-right" />
                    </GridLayout>
                </ListView.itemTemplate>
            </ListView>
        </StackLayout>
    </GridLayout>
</Page> 